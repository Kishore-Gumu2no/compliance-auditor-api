# FairPay Engine - Backend Environment Variables
# Copy this file to .env and fill in YOUR values

# ═══════════════════════════════════════════════════════════════
# REQUIRED: You MUST get these two keys yourself
# ═══════════════════════════════════════════════════════════════

# AI Models (Groq - Llama 3.3 70B)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Vector Database (Qdrant Cloud) - for temporal labor law RAG
# Get free tier at: https://cloud.qdrant.io/
QDRANT_URL=your_qdrant_instance_url
QDRANT_API_KEY=your_qdrant_api_key

