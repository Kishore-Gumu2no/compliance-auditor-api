# FairPay Engine - environment configuration
#
# 1. Copy this file to `.env` in the repository root:
#        copy .env.example .env        (Windows)
#        cp .env.example .env          (macOS / Linux)
# 2. Fill in your own values below.
#
# `.env` is git-ignored and is never copied into Docker images. Docker Compose
# reads it automatically; the backend and the Telegram bot also read it when
# run directly on your machine. Never commit real keys.

# ═══════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════

# Groq API key - used by the audit agents (openai/gpt-oss-120b) and by
# document extraction. The backend will not start without it.
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Image-capable Groq model that reads screenshots and scanned PDF pages
# (personal details are blacked out first). Must be available on your account.
FAIRPAY_VISION_MODEL=qwen/qwen3.8-27b

# ═══════════════════════════════════════════════════════════════
# TELEGRAM EVIDENCE BOT (only needed if you run telegram_bot.py)
# ═══════════════════════════════════════════════════════════════

# Create a bot with @BotFather on Telegram and paste its token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Link to your bot, shown as the "Upload your documents through Telegram"
# button on the website, e.g. https://t.me/<your_bot_username>
VITE_TELEGRAM_BOT_URL=

# Where the bot tells partners to open their full results
FAIRPAY_WEBSITE_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════

# Qdrant vector database for legal-text search. Not needed by default: the
# audit uses the bundled local law file (Backend/real_laws.json).
QDRANT_URL=
QDRANT_API_KEY=

# ═══════════════════════════════════════════════════════════════
# LOCAL SERVICES - defaults work as-is
# ═══════════════════════════════════════════════════════════════
# Inside Docker these are overridden automatically (database host `db`,
# PostgREST `http://rest:3000`, Tesseract `/usr/bin/tesseract`). The values
# below are used when you run the backend or the Telegram bot on your machine.

# PostgreSQL published by the `db` container
DB_HOST=localhost
DB_PORT=54322
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Local Supabase REST API (PostgREST) and its local anon key
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNvbXBsaWFuY2UtYXVkaXRvciIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzM0NTY3MjAwLCJleHAiOjIwNTAxNDMyMDB9.RUTBxvLXcucyr3uc_8kwulN1lswinEB65uf2b9k49_w

# Tesseract OCR binary for runs on your machine
# (Windows default: C:/Program Files/Tesseract-OCR/tesseract.exe)
TESSERACT_PATH=/usr/bin/tesseract
