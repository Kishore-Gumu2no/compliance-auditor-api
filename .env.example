# FairPay Engine - Backend Environment Variables
# Copy this file to .env and fill in your values

# AI Models (Groq - Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# Vector Database (Qdrant) - for temporal labor law RAG
QDRANT_URL=your_qdrant_instance_url
QDRANT_API_KEY=your_qdrant_api_key

# Relational Database (Supabase) - for audit logs and earnings
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_key

# OCR Configuration
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: /usr/bin/tesseract
TESSERACT_PATH=/usr/bin/tesseract