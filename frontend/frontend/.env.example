# FairPay Engine Frontend Environment Variables
# Copy this file to .env.local for local development

# API Base URL (for local development)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Demo Mode - Set to 'true' for Vercel deployment
# When true, uses sample data instead of connecting to backend
VITE_DEMO_MODE=false

# Link to the FairPay Telegram bot shown in "Upload Your Evidence"
# (for example https://t.me/<your_bot_username>). Leave empty to show the
# button as "not configured".
VITE_TELEGRAM_BOT_URL=
